{
  "name": "gatchawek",
  "version": "1.0.0",
  "description": "Discord photocard gacha bot (Cloudflare Workers + Hono)",
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate-manifest.ts",
    "fetch-images": "tsx scripts/fetch-images.ts",
    "build:cards": "tsx scripts/build-cards.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:remote": "SEED_TARGET=remote tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "discord-api-types": "^0.38.59",
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
