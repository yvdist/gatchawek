{
  "name": "gatchawek",
  "version": "1.0.0",
  "description": "Discord photocard gacha bot (Cloudflare Workers + Hono)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "tsx scripts/register-commands.ts",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "validate": "tsx scripts/validate-manifest.ts",
    "fetch-images": "tsx scripts/fetch-images.ts",
    "build:cards": "tsx scripts/build-cards.ts",
    "render-inject": "tsx scripts/render-r2.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:remote": "tsx scripts/seed.ts --remote",
    "seed:staging": "tsx scripts/seed.ts --env staging",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "ingest": "tsx scripts/ingest.ts",
    "approve": "tsx scripts/approve.ts",
    "reset:progress": "tsx scripts/reset-progress.ts --yes",
    "reset:progress:remote": "tsx scripts/reset-progress.ts --remote --yes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@sentry/cloudflare": "^11.15.0",
    "@sentry/hono": "^11.15.0",
    "discord-api-types": "^0.38.59",
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "gifenc": "^1.0.3",
    "miniflare": "^4.20260730.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
