{
  "name": "gatchawek",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gatchawek",
      "database_id": "f9acc0cf-45ff-44b3-8736-dc790370bb0a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CARDS",
      "bucket_name": "gatchawek-cards"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "gatchawek.yudistiraeka-pratama012.workers.dev",
    "INGEST_CHANNEL_ID": "1573206124168216637",
    "INGEST_GUILD_ID": "869121487020372020",
    "MAINTENANCE_UNTIL": "2026-11-22T00:05:00Z"
  },
  "env": {
    "staging": {
      "vars": {
        "PUBLIC_BASE_URL": "gatchawek-staging.yudistiraeka-pratama012.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gatchawek-staging",
          "database_id": "f2c7a563-6b23-47dc-9758-c63f844d5d6c",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CARDS",
          "bucket_name": "gatchawek-cards-staging"
        }
      ]
    }
  }
}
